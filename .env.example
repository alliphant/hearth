# Hearth orchestrator + ingestor — environment overrides
#
# All settings have sane defaults in code; this file documents what's
# tunable. Copy to `.env` and uncomment to override.

# ── Core paths ────────────────────────────────────────────────────────────
# HEARTH_VAULT_ROOT=/home/jasper/vault-friday
# HEARTH_DB_PATH=./data/hearth.db
# HEARTH_PORT=7700

# ── LLM routing ───────────────────────────────────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434
# HEARTH_ROLES_PATH=./config/llm-roles.yaml
# OPENAI_BASE_URL=
# OPENAI_API_KEY=

# ── Policy gateway ────────────────────────────────────────────────────────
# HEARTH_POLICY_PATH=./config/policies/v0.yaml
# HEARTH_APPROVAL_TTL_HOURS=24

# ── Approval push to user (Hermes-side) ───────────────────────────────────
# Strategy 1 — Hermes HTTP push API (preferred when available):
# HERMES_API_URL=
# HERMES_API_SECRET=
#
# Strategy 2 — direct Telegram Bot API fallback:
# TELEGRAM_BOT_TOKEN=<bot token from BotFather>
# HERMES_USER_CHAT_ID=<your Telegram numeric user id>
#
# Strategy 3 — neither set: approval still queued and discoverable
# via `GET /approvals?status=open` or the Hermes tool
# `hearth_list_pending_approvals`. A `push_failed` audit row is written
# so it's visible in the audit trail.

# ── Ingestor ──────────────────────────────────────────────────────────────
# HEARTH_INGESTOR_DEBOUNCE_MS=500

# ── Specialist runtime (Prompt 6a) ────────────────────────────────────────
# HEARTH_SPECIALISTS_DIR=./config/specialists
# HEARTH_AUTONOMY_PATH=./config/autonomy.yaml
# HEARTH_TEST_MODE=0      # 1 = canned LLM responses for smoke tests

# ── Connectors — read-only external services ──────────────────────────────
# Firecrawl (local instance for "fetch this URL as clean markdown"):
# FIRECRAWL_BASE_URL=http://localhost:3002
# FIRECRAWL_API_KEY=
#
# SearXNG (local metasearch for web_search):
# SEARXNG_BASE_URL=http://localhost:8888
#
# Reddit (read_subreddit / read_reddit_thread / read_reddit_user).
# No config needed: the tools read reddit's public RSS feeds (degraded —
# no scores/counts). OPTIONAL upgrade to full-fidelity OAuth reads if
# reddit ever approves an app credential (approval-gated since late
# 2025); see docs/reddit-oauth.md.
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# Optional UA override, reddit's required shape: <platform>:<app>:<ver> (by /u/<owner>)
# REDDIT_USER_AGENT=
#
# Home Assistant (long-lived access token from your HA profile page):
# HA_BASE_URL=http://homeassistant.local:8123
# HA_TOKEN=
#
# (CalDAV calendar env retired 2026-06-14 — calendar reads now come from
#  the iOS calendar snapshot via POST /api/sensors/calendar, no
#  server-side Apple app-specific password. See
#  BACKEND_HA_CALDAV_DEPRECATION_BRIEF.)
#
# FRIDAY/Helix kiosk status endpoint:
# FRIDAY_UI_STATUS_URL=http://localhost:3000/api/status

# ── Maps stack (Prompt 7.5) ───────────────────────────────────────────────
# Local OSRM + Nominatim default to localhost; install via ops/maps/setup.sh.
# NOMINATIM_BASE_URL=http://localhost:8989
# OSRM_DRIVE_URL=http://localhost:5001
# OSRM_BIKE_URL=http://localhost:5002
# OSRM_WALK_URL=http://localhost:5003
# OVERPASS_URL=https://overpass-api.de/api/interpreter   # used by nearby; co-host an Overpass instance if you want fully local
#
# Optional Mapbox fallback — set MAPBOX_TOKEN to enable traffic-aware
# routing + Places POI search when the local stack returns nothing.
# MAPBOX_TOKEN=
#
# Optional Google Maps Platform — highest-quality ETAs at a cost.
# GOOGLE_MAPS_API_KEY=
#
# Provider selection (default 'osrm' primary; fallback auto-detected).
# MAPS_PRIMARY=osrm
# MAPS_FALLBACK=             # 'mapbox' | 'google' | leave blank for auto
# MAPS_HIGH_PRECISION=false  # true = always overlay Mapbox traffic-aware ETA on top of OSRM
#
# ── HA Companion location (Prompt 7.5) ───────────────────────────────────
# Set HA_DEVICE_TRACKER_ENTITY to enable spatial awareness. The other
# entities are optional but improve confidence + signal richness.
# HA_DEVICE_TRACKER_ENTITY=device_tracker.jasons_iphone
# HA_GEOCODED_LOCATION_ENTITY=sensor.jasons_iphone_geocoded_location
# HA_ACTIVITY_ENTITY=sensor.jasons_iphone_activity
# HA_BATTERY_LEVEL_ENTITY=sensor.jasons_iphone_battery_level
# HA_BATTERY_STATE_ENTITY=sensor.jasons_iphone_battery_state
# HA_CONNECTION_ENTITY=sensor.jasons_iphone_connection_type
#
# ── EV (Iris's plan_ev_day) ──────────────────────────────────────────────
# Conservative kWh-per-mile estimate (default 0.35 — Hyundai EPA is
# ~0.28-0.30 but cold weather, highway speeds, and climate control
# add real overhead).
# IONIQ5_KWH_PER_MILE_CONSERVATIVE=0.35
# IONIQ5_USABLE_KWH=77.4
# IONIQ5_SOC_ENTITY=sensor.ioniq5_state_of_charge
# IONIQ5_RANGE_ENTITY=sensor.ioniq5_range
#
# ── Kate's brief — verified life-context entity IDs ──────────────────────
# These entities are pre-pumped into Kate's brief prompt at each report
# slot (07:00 / 12:30 / 18:00 / 22:00) as a `verified_life_context` block.
# Unset entities surface as `status: 'unavailable'` in the prompt — Kate
# is explicitly forbidden from stating a value she doesn't see in the
# verified block. This is the load-bearing rule that prevents
# "Ioniq 5 at 97%" type hallucinations when the SoC entity isn't wired.
# IONIQ5_SOC_ENTITY (above) is reused for EV state-of-charge.
# IONIQ5_RANGE_ENTITY (above) is reused for EV range.
# HEARTH_BRIEF_WEATHER_ENTITY=weather.home
# HEARTH_BRIEF_PRECIP_PROB_TODAY_ENTITY=sensor.daily_precip_probability
# HEARTH_BRIEF_INDOOR_TEMP_ENTITY=sensor.living_room_temperature
# Comma-separated HA calendar entity_ids. Today + tomorrow's events
# from these are surfaced in the verified block.
# HEARTH_BRIEF_CALENDAR_ENTITY_IDS=calendar.personal,calendar.family
#
# ── Privacy ──────────────────────────────────────────────────────────────
# Path to the privacy YAML. Audit redaction defaults ON; only override
# if you really want a precise location journal in the audit log.
# HEARTH_PRIVACY_PATH=./config/privacy.yaml

# ── Media apps (Cordelia + Maggie: Sonarr/Radarr/Lidarr/Readarr + Plex/Tautulli) ──
# URLs default to your-llm-host.local on the standard ports for dev/standalone
# runs. **Inside the the LLM host docker deploy (2026-05-29+) override to
# `host.docker.internal:<port>`** — Hearth runs on docknet, Plex is
# host-net, Tautulli is on docker_default; routing through the docker
# host gateway is uniform across all three. API keys come from each app's
# Settings → General → Security → API Key. An app left without a key is
# simply unavailable — its tools return "not configured" and the arr
# smoke skips it.
# SONARR_URL=http://your-llm-host.local:8989    # docker: http://host.docker.internal:8989
# SONARR_API_KEY=
# RADARR_URL=http://your-llm-host.local:7878    # docker: http://host.docker.internal:7878
# RADARR_API_KEY=
# LIDARR_URL=http://your-llm-host.local:8686    # docker: http://host.docker.internal:8686
# LIDARR_API_KEY=
# READARR_URL=http://your-llm-host.local:8787   # docker: http://host.docker.internal:8787
# READARR_API_KEY=
# PLEX_URL=http://your-llm-host.local:32400     # docker: http://host.docker.internal:32400
# PLEX_TOKEN=
# PLEX_USER=                              # default Tautulli user to filter to (blank = all)
# TAUTULLI_URL=http://your-llm-host.local:8181  # docker: http://host.docker.internal:8181
# TAUTULLI_API_KEY=
# TAUTULLI_WEBHOOK_PATH=/api/maggie/plex_event

# ── APNs (Apple Push Notification service — direct iOS push) ──────────────
# Per Jasper's 2026-05-26 directive, iOS pushes go Hearth → Apple → device
# directly (no Hermes/Telegram routing). The .p8 key is downloaded from
# App Store Connect → Keys; the Key ID lives in the filename. Team ID is
# constant across Hearth ("5YZ954NEUY"). Topic = bundle id of the iOS app.
# Live Activity topic = "<bundle>.push-type.liveactivity" by default.
# Leaving any of these unset disables iOS push as a no-op (Telegram still
# works).
# APNS_KEY_PATH=/home/jasper/projects/keys/APN/AuthKey_M76HN6F924.p8
# APNS_KEY_ID=M76HN6F924
# APNS_TEAM_ID=5YZ954NEUY
# APNS_TOPIC=com.hearthcrew.app
# APNS_LIVE_ACTIVITY_TOPIC=com.hearthcrew.app.push-type.liveactivity

# ── Cordelia visual-understanding pipeline ────────────────────────────────
# The visual layer behind /api/cordelia/capture. Captures are persisted
# regardless of these settings; the classifier just downgrades (falls back
# to OCR-only routing, then to Kate-triage interrupts) when vision isn't
# reachable.
#
# Vision now rides the same OPENAI_BASE_URL as text. the LLM host's
# Qwen3.6-27B is loaded with mmproj (2026-05-26+), so
# /v1/chat/completions accepts the OpenAI vision content shape directly
# — `analyze_image`, the classifier's scene track, and every
# `consult_deep_model` invocation can attach an image for free. The
# provider transcodes HEIC → JPEG via ffmpeg on the orchestrator host
# (libheif-enabled ffmpeg on the always-on host) before sending. No separate VL URL.
#
# Set to 0 to disable image attachment on the OpenAI provider (text-only
# endpoint, or a known-buggy build). Default ON when OPENAI_BASE_URL is
# set.
# OPENAI_VISION_AVAILABLE=1
#
# PaddleOCR CPU sidecar — fallback for captures whose iOS-side Vision OCR
# text was empty or non-English. Spec lives in ops/ocr/. The classifier
# only invokes the OCR sidecar when the on-device text is below the doc-
# track threshold AND HEARTH_OCR_FALLBACK_ENABLED is unset / 1.
# HEARTH_OCR_BASE_URL=http://localhost:8090
# HEARTH_OCR_FALLBACK_ENABLED=1
# HEARTH_OCR_TIMEOUT_MS=30000

# ── Smoke-test fixtures (optional; the smoke skips when unset) ────────────
# TEST_HA_ENTITY_ID=sun.sun
# TEST_HOME_LAT=39.7305
# TEST_HOME_LON=-104.9822

# ── Image generation ────────────────────────────────────────────────────────
# GPU ComfyUI on forza (Krea 2 Turbo — the generate_image chat tool). Unset ⇒
# the tool reports itself unavailable. This is the ONLY image endpoint; the
# CPU FLUX instance it used to be contrasted with was retired 2026-07-30.
# HEARTH_IMAGEGEN_COMFYUI_URL=http://192.168.0.188:8188
# HEARTH_IMAGEGEN_TIMEOUT_MS=150000
