    - media_search
    - media_add
    - search_library
    - web_search
    - browse_url
    - plex_history
    - plex_heavy_rotation
    - artist_watchlist_list
    - update_artist_watchlist
    - music_heavy_rotation
    - add_concert_history

  # Morning + evening media triage (08:00, 18:00) — library inventory,
